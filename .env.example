ANTHROPIC_API_KEY=your-api-key-here

# Optional: shown in the sidebar so you can tell which Google account is
# connected. Leave unset to display nothing.
AGENT_ADAM_ACCOUNT_LABEL=

# Optional: IANA timezone name for calendar windows. Must be a zone name, not a
# fixed offset — the offset changes with DST.
AGENT_ADAM_TIMEZONE=America/Denver

# Optional: model and output cap.
AGENT_ADAM_MODEL=claude-sonnet-5
AGENT_ADAM_MAX_TOKENS=4096
